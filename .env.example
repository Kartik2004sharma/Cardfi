# WalletConnect Project ID - Get from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Demo Mode — strictly controls fallback mock data
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------
# Circle API — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Putting this under NEXT_PUBLIC_ ships your secret to the browser bundle.
# -----------------------------------------------------------------------
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENVIRONMENT=sandbox
CIRCLE_API_URL=https://api-sandbox.circle.com/v1

# LI.FI API key (get from https://li.fi/)
LIFI_API_KEY=your_lifi_api_key_here

# Deployer private key — for Hardhat scripts only. NEVER commit a real key.
PRIVATE_KEY=your_deployer_private_key_here

# RPC URLs for each supported testnet
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Contract addresses — updated automatically by the deploy script
NEXT_PUBLIC_SEPOLIA_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SEPOLIA_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SEPOLIA_YIELD_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ARBITRUM_SEPOLIA_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ARBITRUM_SEPOLIA_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_SEPOLIA_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_SEPOLIA_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
