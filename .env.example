# WalletConnect Project ID - Get from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Circle API Configuration
CIRCLE_API_KEY=your_circle_api_key_here
NEXT_PUBLIC_CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENVIRONMENT=sandbox
CIRCLE_API_URL=https://api-sandbox.circle.com/v1

# RPC URLs for different networks (optional - wagmi has defaults)
NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your-infura-key
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key

# Contract Addresses (update with your deployed contracts)
NEXT_PUBLIC_MAINNET_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_POLYGON_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SEPOLIA_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# API Keys (if needed for additional services)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key_here
NEXT_PUBLIC_INFURA_PROJECT_ID=your_infura_project_id
